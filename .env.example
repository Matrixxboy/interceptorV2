# fpv-autonomous-tracker environment variables
# Copy to .env and customize for your setup

# Flight controller
FC_PORT=/dev/ttyAMA0
FC_BAUD=921600

# Ground station network
GCS_HOST=192.168.1.10
TELEMETRY_PORT=5005
VIDEO_PORT=5600

# Camera source: picamera2 | v4l2 | file
CAMERA_SOURCE=picamera2

# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
