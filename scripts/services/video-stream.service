[Unit]
Description=FPV Low-Latency Video Stream Service
After=network.target

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/fpv-autonomous-tracker
ExecStart=/usr/bin/gst-launch-1.0 libcamerasrc ! video/x-raw,width=1280,height=720,framerate=30/1 ! v4l2h264enc extra-controls="controls,video_bitrate=2500000,h264_profile=1,repeat_sequence_header=1" ! rtph264pay config-interval=1 pt=96 ! udpsink host=192.168.1.10 port=5600 sync=false
Restart=on-failure
RestartSec=2

[Install]
WantedBy=multi-user.target
